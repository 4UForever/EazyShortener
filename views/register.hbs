<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Register | EazyShortener</title>
    <link rel="stylesheet" href="/assets/app.css" />
  </head>
  <body>
    <main class="auth-shell">
      <section class="auth-card" aria-labelledby="register-title">
        <a class="brand-mark" href="/">EazyShortener</a>
        <p class="eyebrow">Create your account</p>
        <h1 id="register-title">Register</h1>
        <p class="auth-intro">Verify your email before signing in and using member features.</p>
        {{authFeedback}}
        <form method="post" action="/register" class="auth-form">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required value="{{authEmail}}" />
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required />
          <button type="submit">Create account</button>
        </form>
        <p class="auth-switch">Already verified? <a href="/login">Sign in</a></p>
      </section>
    </main>
  </body>
</html>
