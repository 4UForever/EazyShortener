<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Email verification | EazyShortener</title>
    <link rel="stylesheet" href="/assets/app.css" />
  </head>
  <body>
    <main class="auth-shell">
      <section class="auth-card" aria-labelledby="verification-title">
        <a class="brand-mark" href="/">EazyShortener</a>
        <p class="eyebrow">Email verification</p>
        <h1 id="verification-title">{{verifyTitle}}</h1>
        <p class="auth-intro">{{verifyMessage}}</p>
        <p class="auth-switch">{{verifyAction}}</p>
      </section>
    </main>
  </body>
</html>
